@page "/counter"
@rendermode InteractiveServer

<PageTitle>Counter</PageTitle>

<div class="space-y-6">
	<div>
		<p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--app-text-muted)]">Demo</p>
		<h1 class="text-3xl font-black tracking-tight text-[var(--app-text)]">Counter</h1>
	</div>

	<div class="flex items-center gap-4">
		<p role="status" class="text-lg text-[var(--app-text-muted)]">
			Current count: <span class="font-bold text-[var(--app-brand-strong)]">@currentCount</span>
		</p>
	</div>

	<button type="button" class="inline-flex items-center justify-center rounded-xl bg-[var(--app-brand)] px-4 py-2.5 text-sm font-semibold text-white shadow-lg shadow-sky-500/20 transition hover:bg-[var(--app-brand-strong)]" @onclick="IncrementCount">
		Increment
	</button>
</div>

@code {
	private int currentCount = 0;

	private void IncrementCount()
	{
		currentCount++;
	}
}
