@page "/admin/users"
@using Web.Components.Features.UserManagement.AddUserRoles
@using Web.Components.Features.UserManagement.GetUserRoles
@using Web.Components.Features.UserManagement.GetUserWithRoles
@inject IMediator Sender
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]


<PageTitle>Manage Roles</PageTitle>

<section class="app-page-stack">
	<div class="app-page-card">
		<h2 class="app-h2">Manage User Roles</h2>
		@if (_availableRoles.Count > 0)
		{
			<p class="app-copy">
				Available roles: @string.Join(", ", _availableRoles.Select(role => role.Name))
			</p>
		}
	</div>

	@if (_error is not null)
	{
		<div class="alert-error" role="alert">
			<span>@_error</span>
			<button type="button" class="alert-dismiss" aria-label="Close error" @onclick="() => _error = null">&times;</button>
		</div>
	}

	<section class="app-panel-card">
		<div class="app-section-header">
			<h2 class="app-section-title">Users</h2>
			<span class="app-badge">@_users.Count total</span>
		</div>

		@if (_loading)
		{
			<p class="app-copy">Loading users...</p>
		}
		else if (_users.Count == 0)
		{
			<p class="app-copy">No users to show yet.</p>
		}
		else
		{
			<div class="overflow-x-auto">
				<table class="app-table zebra-grid">
					<thead>
						<tr>
							<th>User</th>
							<th>Email</th>
							<th>Current Roles</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var user in _users)
						{
							<tr>
								<td class="font-medium whitespace-nowrap">@user.Name</td>
								<td class="text-(--app-text-muted)">@user.Email</td>
								<td>
									<div class="flex flex-wrap gap-1">
										@foreach (var roleName in user.Roles)
										{
											<span class="app-badge">@roleName</span>
										}
									</div>
								</td>
								<td>
									<div class="flex flex-wrap">
										@foreach (var role in _availableRoles)
										{
											var hasRole = user.Roles.Contains(role.Name);
											if (hasRole)
											{
												<button type="button" class="role-toggle role-toggle-active"
																title="Remove @role.Name role" @onclick="() => RemoveRole(user.UserId, role.Id)">
													✓ @role.Name
												</button>
											}
											else
											{
												<button type="button" class="role-toggle role-toggle-inactive"
																title="Add @role.Name role" @onclick="() => AssignRole(user.UserId, role.Id)">
													+ @role.Name
												</button>
											}
										}
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
</section>

@code {
	private IReadOnlyList<UserWithRolesDto> _users = [];
	private IReadOnlyList<RoleDto> _availableRoles = [];
	private bool _loading = true;
	private string? _error;

	protected override async Task OnInitializedAsync()
	{
		var usersTask = Sender.Send(new GetUsersWithRolesQuery());
		var rolesTask = Sender.Send(new GetAvailableRolesQuery());
		await Task.WhenAll(usersTask, rolesTask);

		var usersResult = await usersTask;
		var rolesResult = await rolesTask;

		if (usersResult.Success) _users = usersResult.Value!;
		else _error = usersResult.Error;

		if (rolesResult.Success) _availableRoles = rolesResult.Value!
			.OrderBy(static role => role.Name, StringComparer.OrdinalIgnoreCase)
			.ToArray();
		else _error ??= rolesResult.Error;

		_loading = false;
	}

	private async Task AssignRole(string userId, string roleId)
	{
		var result = await Sender.Send(new AssignRoleCommand(userId, roleId));
		if (result.Failure) { _error = result.Error; return; }
		await RefreshAsync();
	}

	private async Task RemoveRole(string userId, string roleId)
	{
		var result = await Sender.Send(new RemoveRoleCommand(userId, roleId));
		if (result.Failure) { _error = result.Error; return; }
		await RefreshAsync();
	}

	private async Task RefreshAsync()
	{
		var result = await Sender.Send(new GetUsersWithRolesQuery());
		if (result.Success) _users = result.Value!;
		StateHasChanged();
	}
}
