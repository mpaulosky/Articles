@page "/categories"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.QuickGrid
@using Web.Components.Features.Categories.Commands
@using Web.Components.Features.Categories.Components
@using Web.Components.Features.Categories.Models
@using Web.Components.Features.Categories.Queries
@inject IMediator Sender
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Categories</PageTitle>

<section class="app-page-stack">
	<div class="app-page-card">
		<div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
			<div>
				<h2 class="app-h2">Categories</h2>
			</div>
			<div>
				<p class="app-pill">Details</p>
			</div>
			<div class="flex flex-wrap items-center gap-4">
				<label class="flex items-center gap-2 text-sm font-medium text-(--app-text)">
					<input type="checkbox" class="h-4 w-4 rounded border-slate-400 text-sky-600 focus:ring-sky-500"
								 @bind="_includeArchived" />
					Include Archived
				</label>

				<button type="button"
								class="app-button app-button-primary"
								@onclick="OpenCreatePanel">
					Create Category
				</button>
			</div>
		</div>
	</div>

	@if (_showCreatePanel)
	{
		<section class="app-panel-card">
			<div class="app-section-header">
				<h2 class="app-section-title">Create category</h2>
				<button type="button"
								class="app-button app-button-secondary"
								@onclick="CloseCreatePanel">
					Cancel
				</button>
			</div>

			@if (!string.IsNullOrWhiteSpace(_createError))
			{
				<div class="alert-error" role="alert">@_createError</div>
			}

			<CategoryForm Model="_form" Saving="_saving" SubmitLabel="Create category"
										OnValidSubmit="CreateCategoryAsync" />
		</section>
	}

	<section class="app-panel-card">
		<div class="app-section-header">
			<h2 class="app-section-title">Categories</h2>
			<span class="app-badge">@FilteredCategoryList.Count total</span>
		</div>

		@if (!string.IsNullOrWhiteSpace(_loadError))
		{
			<div class="alert-error" role="alert">@_loadError</div>
		}

		@if (_loading)
		{
			<p class="app-copy">Loading categories...</p>
		}
		else if (FilteredCategoryList.Count == 0)
		{
			<p class="app-copy">No categories yet. Create the first one above.</p>
		}
		else
		{
			<div class="overflow-x-auto">
				<QuickGrid TGridItem="CategoryDto" Items="@FilteredCategories"
									 Class="zebra-grid w-full text-left text-sm">
					<TemplateColumn Title="Name" Sortable="true" IsDefaultSortColumn="true"
													SortBy="@(GridSort<CategoryDto>.ByAscending(c => c.CategoryName))" Class="font-medium text-(--app-text)">
						@context.CategoryName
						@if (context.IsArchived)
						{
							<span class="app-badge ml-2" role="status">Archived</span>
						}
					</TemplateColumn>

					<PropertyColumn Property="@(c => c.Slug)" Title="Slug" Sortable="true" />

					<TemplateColumn Title="Description" Sortable="false">
						@context.Description
					</TemplateColumn>

					<TemplateColumn Sortable="false" Class="text-center">
						<HeaderTemplate>
							<div class="flex justify-center font-bold">Actions</div>
						</HeaderTemplate>
						<ChildContent Context="context">
							<div class="flex flex-nowrap items-center justify-center gap-1.5 whitespace-nowrap">
								<button type="button"
												class="app-button app-button-primary w-24"
												@onclick="() => StartEdit(context)">
									Edit
								</button>
								@if (context.IsArchived)
								{
									<button type="button"
													class="app-button app-button-unsetvalue w-24"
													@onclick="() => UnarchiveCategoryAsync(context.Id.ToString())">
										Unarchive
									</button>
								}
								else
								{
									<button type="button"
													class="app-button app-button-warning w-24"
													@onclick="() => RequestArchive(context.Id.ToString())">
										Archive
									</button>
								}
							</div>
						</ChildContent>
					</TemplateColumn>
				</QuickGrid>
			</div>
		}
	</section>
</section>

@if (_editingCategoryId is not null)
{
	<div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/50 p-4" role="presentation"
			 @onclick="CancelEdit">
		<div class="app-panel-card w-full max-w-lg" role="dialog"
				 aria-modal="true" aria-labelledby="edit-modal-title" @onclick:stopPropagation="true">
			<div class="app-section-header">
				<h2 id="edit-modal-title" class="app-section-title">Edit category</h2>
				<button type="button"
								class="app-button app-button-secondary"
								@onclick="CancelEdit">
					Cancel
				</button>
			</div>

			@if (!string.IsNullOrWhiteSpace(_editError))
			{
				<div class="alert-error" role="alert">@_editError</div>
			}

			<CategoryForm Model="_editForm" Saving="_saving" SubmitLabel="Save changes"
										OnValidSubmit="UpdateCategoryAsync" />
		</div>
	</div>
}

@if (_pendingArchiveId is not null)
{
	<div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/50 p-4" role="presentation"
			 @onclick="CancelArchive">
		<div class="app-panel-card w-full max-w-sm" role="dialog"
				 aria-modal="true" aria-labelledby="archive-modal-title" @onclick:stopPropagation="true">
			<h2 id="archive-modal-title" class="text-lg font-semibold text-(--app-text)">Archive category?</h2>
			<p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
				"@_pendingArchiveName" will be hidden from the default category list. You can unarchive it later.
			</p>
			<div class="mt-6 flex justify-end gap-2">
				<button type="button"
								class="app-button app-button-secondary"
								@onclick="CancelArchive">
					Cancel
				</button>
				<button type="button"
								class="app-button app-button-warning"
								@onclick="() => ArchiveCategoryAsync(_pendingArchiveId!)">
					Confirm
				</button>
			</div>
		</div>
	</div>
}

@code {
	private readonly CategoryFormModel _form = new();
	private readonly CategoryFormModel _editForm = new();
	private readonly List<CategoryDto> _categories = [];
	private bool _loading;
	private bool _saving;
	private bool _showCreatePanel;
	private bool _includeArchived;
	private string? _createError;
	private string? _editError;
	private string? _loadError;
	private string? _editingCategoryId;
	private string? _pendingArchiveId;

	private List<CategoryDto> FilteredCategoryList =>
		[.. _categories.Where(category => _includeArchived || !category.IsArchived)];

	private IQueryable<CategoryDto> FilteredCategories => FilteredCategoryList.AsQueryable();

	private string? _pendingArchiveName => _categories.FirstOrDefault(c => c.Id.ToString() == _pendingArchiveId)?.CategoryName;

	protected override async Task OnInitializedAsync()
	{
		await LoadAsync();
	}

	private void OpenCreatePanel()
	{
		_showCreatePanel = true;
	}

	private void CloseCreatePanel()
	{
		_showCreatePanel = false;
		_createError = null;
		_form.Reset();
	}

	private async Task LoadAsync()
	{
		_loading = true;
		_loadError = null;

		var result = await Sender.Send(new GetCategoriesQuery());
		if (result.Success)
		{
			_categories.Clear();
			_categories.AddRange(result.Value ?? []);
		}
		else
		{
			_loadError = result.Error;
		}

		_loading = false;
	}

	private async Task CreateCategoryAsync()
	{
		_saving = true;
		_createError = null;

		var result = await Sender.Send(new CreateCategoryCommand(_form.Name.Trim(), _form.Description.Trim()));
		if (result.Success)
		{
			_form.Reset();
			_showCreatePanel = false;
			await LoadAsync();
		}
		else
		{
			_createError = result.Error;
		}

		_saving = false;
	}

	private void StartEdit(CategoryDto category)
	{
		_editError = null;
		_editingCategoryId = category.Id.ToString();
		_editForm.Name = category.CategoryName;
		_editForm.Description = category.Description;
	}

	private void CancelEdit()
	{
		_editingCategoryId = null;
		_editError = null;
		_editForm.Reset();
	}

	private async Task UpdateCategoryAsync()
	{
		if (_editingCategoryId is null)
		{
			return;
		}

		_saving = true;
		_editError = null;

		var result = await Sender.Send(
			new UpdateCategoryCommand(_editingCategoryId, _editForm.Name.Trim(), _editForm.Description.Trim()));
		if (result.Success)
		{
			CancelEdit();
			await LoadAsync();
		}
		else
		{
			_editError = result.Error;
		}

		_saving = false;
	}

	private void RequestArchive(string id)
	{
		_pendingArchiveId = id;
	}

	private void CancelArchive()
	{
		_pendingArchiveId = null;
	}

	private async Task ArchiveCategoryAsync(string id)
	{
		_loadError = null;
		_pendingArchiveId = null;
		var result = await Sender.Send(new ArchiveCategoryCommand(id));
		if (result.Success)
		{
			await LoadAsync();
		}
		else
		{
			_loadError = result.Error;
		}
	}

	private async Task UnarchiveCategoryAsync(string id)
	{
		_loadError = null;
		var result = await Sender.Send(new UnarchiveCategoryCommand(id));
		if (result.Success)
		{
			await LoadAsync();
		}
		else
		{
			_loadError = result.Error;
		}
	}
}
