@page "/articles/{Slug}"
@rendermode InteractiveServer
@using System.Security.Claims
@using Ganss.Xss
@using Markdig
@using Web.Components.Features.Articles.Authorization
@using Web.Components.Features.Articles.Models
@using Web.Components.Features.Articles.Queries
@inject IMediator Sender
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>@(_article is null ? "Article" : _article.Title)</PageTitle>

<section class="app-page-stack">
	<div class="app-page-card">
		<div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
			<div>
				<h2 class="app-h2">View Article</h2>
			</div>
			<div>
				<p class="app-pill">Viewing</p>
			</div>
			<div class="flex flex-wrap items-center gap-4">
				<button type="button" class="app-button app-button-secondary" @onclick="Cancel">
					Cancel
				</button>
			</div>
		</div>
	</div>

	<section class="app-panel-card">
		@if (_loading)
		{
			<p class="app-copy">Loading article...</p>
		}
		else if (!string.IsNullOrWhiteSpace(_error))
		{
			<div class="alert-error" role="alert">@_error</div>
		}
		else if (_article is not null)
		{
			<div class="flex flex-col gap-4">
				<div class="flex flex-wrap items-center gap-2">
					@if (_article.IsArchived)
					{
						<span class="app-badge" role="status">Archived</span>
					}
					<span class="app-badge">@(_article.IsPublished ? "Published" : "Draft")</span>
				</div>

				<h2 class="app-h1">@_article.Title</h2>

				<p class="text-sm text-slate-600 dark:text-slate-300">
					By @_article.Author.Name &middot; @_article.Category.CategoryName
					@if (_article.IsPublished && _article.PublishedOn is not null)
					{
						<text> &middot; Published @_article.PublishedOn.Value.ToString("MMM d, yyyy")</text>
					}
				</p>

				<div class="app-markdown-content">@((MarkupString)RenderContentHtml(_article.Content))</div>
			</div>
		}
	</section>
</section>

@code {
	private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder()
		.UseAdvancedExtensions()
		.Build();

	private static readonly HtmlSanitizer Sanitizer = CreateSanitizer();

	private static HtmlSanitizer CreateSanitizer()
	{
		var sanitizer = new HtmlSanitizer();
		sanitizer.AllowedAttributes.Add("id");
		return sanitizer;
	}

	[Parameter]
	public string Slug { get; set; } = string.Empty;

	private ArticleDto? _article;
	private bool _loading = true;
	private string? _error;
	private ClaimsPrincipal? _currentUser;

	protected override async Task OnInitializedAsync()
	{
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		_currentUser = authState.User;
		await LoadAsync();
	}

	private async Task LoadAsync()
	{
		_loading = true;
		_error = null;
		_article = null;

		var result = await Sender.Send(new GetArticleBySlugQuery(Slug));
		if (!result.Success || result.Value is null)
		{
			_error = result.Error ?? "Article not found.";
			_loading = false;
			return;
		}

		if (!ArticleAuthorizationService.CanViewArticle(_currentUser, result.Value))
		{
			_error = "You don't have permission to view this article.";
			_loading = false;
			return;
		}

		_article = result.Value;
		_loading = false;
	}

	private void Cancel()
	{
		Navigation.NavigateTo("/articles");
	}

	private static string RenderContentHtml(string content)
	{
		var html = Markdown.ToHtml(content, MarkdownPipeline);
		return Sanitizer.Sanitize(html);
	}
}
