@page "/articles/{Slug}/edit"
@rendermode InteractiveServer
@using System.Security.Claims
@using static Domain.Helpers.DomainHelpers
@using Web.Components.Features.Articles.Authorization
@using Web.Components.Features.Articles.Commands
@using Web.Components.Features.Articles.Components
@using Web.Components.Features.Articles.Models
@using Web.Components.Features.Articles.Queries
@using Web.Components.Features.Categories.Models
@using Web.Components.Features.Categories.Queries
@inject IMediator Sender
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>@(_article is null ? "Edit article" : $"Edit {_article.Title}")</PageTitle>

<section class="app-page-stack">
	<div class="app-page-card">
		<div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
			<div>
				<h2 class="app-h2">Edit Articles</h2>
			</div>
			<div>
				<p class="app-pill">Editing</p>
			</div>
			<div class="flex flex-wrap items-center gap-4">
				<button type="button" class="app-button app-button-secondary" @onclick="Cancel">
					Cancel
				</button>
			</div>
		</div>
	</div>

	<section class="app-panel-card">
		@if (_loading)
		{
			<p class="app-copy">Loading article...</p>
		}
		else if (_article is null)
		{
			<div class="alert-error" role="alert">@(_error ?? "Article not found.")</div>
		}
		else
		{
			@if (!string.IsNullOrWhiteSpace(_error))
			{
				<div class="alert-error" role="alert">@_error</div>
			}

			<ArticleForm Model="_form" Categories="_categories" Saving="_saving" SubmitLabel="Save changes"
									 OnValidSubmit="SaveArticleAsync">
			</ArticleForm>
		}
	</section>
</section>

@code {
	[Parameter]
	public string Slug { get; set; } = string.Empty;

	private readonly ArticleFormModel _form = new();
	private readonly List<CategoryDto> _categories = [];
	private ArticleDto? _article;
	private bool _loading = true;
	private bool _saving;
	private string? _error;
	private ClaimsPrincipal? _currentUser;

	protected override async Task OnInitializedAsync()
	{
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		_currentUser = authState.User;
		await LoadCategoriesAsync();
		await LoadArticleAsync();
	}

	private async Task LoadCategoriesAsync()
	{
		var result = await Sender.Send(new GetCategoriesQuery());
		if (result.Success)
		{
			_categories.Clear();
			_categories.AddRange(result.Value ?? []);
		}
	}

	private async Task LoadArticleAsync()
	{
		_loading = true;
		_error = null;
		_article = null;

		var result = await Sender.Send(new GetArticleBySlugQuery(Slug));
		if (!result.Success || result.Value is null)
		{
			_error = result.Error ?? "Article not found.";
			_loading = false;
			return;
		}

		if (!ArticleAuthorizationService.CanEditArticle(_currentUser, result.Value))
		{
			_error = "You don't have permission to edit this article.";
			_loading = false;
			return;
		}

		_article = result.Value;
		_form.Title = _article.Title;
		_form.Content = _article.Content;
		_form.CategoryId = _article.Category.Id.ToString();
		_loading = false;
	}

	private async Task SaveArticleAsync()
	{
		_saving = true;
		_error = null;

		var title = _form.Title.Trim();
		var category = _categories.FirstOrDefault(c => c.Id.ToString() == _form.CategoryId);
		var result = await Sender.Send(new UpdateArticleCommand(
			_article!.Id,
			title,
			title.GenerateSlug(),
			_form.Content.Trim(),
			category,
			ClearCategory: category is null));

		if (result.Success)
		{
			Navigation.NavigateTo($"/articles/{result.Value!.Slug}");
		}
		else
		{
			_error = result.Error;
		}

		_saving = false;
	}

	private void Cancel()
	{
		Navigation.NavigateTo("/articles");
	}
}
