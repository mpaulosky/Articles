@page "/articles"
@rendermode InteractiveServer
@using System.Security.Claims
@using Web.Components.Features.Articles.Authorization
@using Web.Components.Features.Articles.Commands
@using Web.Components.Features.Articles.Models
@using Web.Components.Features.Articles.Queries
@inject IMediator Sender
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Articles</PageTitle>

<section class="app-page-stack">
	<div class="app-page-card">
		<div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
			<div>
				<p class="app-pill">Publishing</p>
				<h1 class="app-h1">Articles</h1>
			</div>
		</div>
	</div>

	<div class="grid gap-6 lg:grid-cols-[0.95fr_1.55fr]">
		<section class="app-panel-card">
			<h2 class="app-section-title">Create article</h2>

			@if (!string.IsNullOrWhiteSpace(_error))
			{
				<div class="alert-error" role="alert">@_error</div>
			}

			<EditForm Model="_form" OnValidSubmit="CreateArticleAsync">
				<DataAnnotationsValidator />
				<ValidationSummary />

				<div class="space-y-4">
					<div>
						<label class="block text-sm font-medium text-(--app-text)">Title</label>
						<InputText @bind-Value="_form.Title"
											 class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" />
					</div>

					<div>
						<label class="block text-sm font-medium text-(--app-text)">Body</label>
						<InputTextArea @bind-Value="_form.Content"
													 class="mt-1 min-h-32 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" />
					</div>

					<div>
						<label class="block text-sm font-medium text-(--app-text)">Author</label>
						<InputText @bind-Value="_form.AuthorName"
											 class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" />
					</div>

					<button type="submit"
									class="inline-flex items-center justify-center rounded-lg bg-sky-600 px-4 py-2 font-medium text-white hover:bg-sky-500 disabled:cursor-not-allowed disabled:opacity-60"
									disabled="@_saving">
						@(_saving ? "Saving..." : "Publish article")
					</button>
				</div>
			</EditForm>
		</section>

		<section class="app-panel-card">
			<div class="app-section-header">
				<h2 class="app-section-title">Article list</h2>
				<span class="app-badge">@_articles.Count total</span>
			</div>

			@if (_loading)
			{
				<p class="app-copy">Loading articles...</p>
			}
			else if (_articles.Count == 0)
			{
				<p class="app-copy">No published articles yet. Create the first one on the left.</p>
			}
			else
			{
				<div class="space-y-3">
					@foreach (var article in _articles)
					{
						<div class="rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-950/40">
							<div class="flex items-start justify-between gap-3">
								<div>
									<h3 class="text-lg font-semibold text-(--app-text)">@article.Title</h3>
									<p class="mt-1 text-sm text-slate-600 dark:text-slate-300">By @article.Author.Name</p>
								</div>
								@if (ArticleAuthorizationService.CanEditArticle(_currentUser, article))
								{
									<button type="button"
												class="rounded border border-rose-500 px-2.5 py-1.5 text-sm font-medium text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/30"
												@onclick="() => DeleteArticleAsync(article.Id)">
										Delete
									</button>
								}
							</div>

							<p class="mt-2 text-sm text-slate-700 dark:text-slate-200">@article.Content</p>
						</div>
					}
				</div>
			}
		</section>
	</div>
</section>

@code {
	private readonly ArticleFormModel _form = new();
	private readonly List<ArticleDto> _articles = [];
	private bool _loading;
	private bool _saving;
	private string? _error;
	private ClaimsPrincipal? _currentUser;

	protected override async Task OnInitializedAsync()
	{
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		_currentUser = authState.User;
		await LoadAsync();
	}

	private async Task LoadAsync()
	{
		_loading = true;
		_error = null;

		var result = await Sender.Send(new GetArticlesQuery());
		if (result.Success)
		{
			var visibleArticles = (result.Value ?? [])
				.Where(article => ArticleAuthorizationService.CanViewArticle(_currentUser, article))
				.ToList();

			_articles.Clear();
			_articles.AddRange(visibleArticles);
		}
		else
		{
			_error = result.Error;
		}

		_loading = false;
	}

	private async Task CreateArticleAsync()
	{
		_saving = true;
		_error = null;

		var result = await Sender.Send(new CreateArticleCommand(
			_form.Title.Trim(),
			_form.Content.Trim(),
			new Web.Components.Features.AuthInfo.Entities.AuthorDto("user-local", _form.AuthorName.Trim(), string.Empty)));

		if (result.Success)
		{
			_form.Reset();
			await LoadAsync();
		}
		else
		{
			_error = result.Error;
		}

		_saving = false;
	}

	private async Task DeleteArticleAsync(string id)
	{
		_error = null;
		var result = await Sender.Send(new DeleteArticleCommand(id));
		if (result.Success)
		{
			await LoadAsync();
		}
		else
		{
			_error = result.Error;
		}
	}

	private sealed class ArticleFormModel
	{
		public string Title { get; set; } = string.Empty;
		public string Content { get; set; } = string.Empty;
		public string AuthorName { get; set; } = string.Empty;

		public void Reset()
		{
			Title = string.Empty;
			Content = string.Empty;
			AuthorName = string.Empty;
		}
	}
}
