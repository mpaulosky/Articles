@page "/articles"
@rendermode InteractiveServer
@using System.Security.Claims
@using static Domain.Helpers.DomainHelpers
@using Web.Components.Features.Articles.Authorization
@using Web.Components.Features.Articles.Commands
@using Web.Components.Features.Articles.Components
@using Web.Components.Features.Articles.Models
@using Web.Components.Features.Articles.Queries
@using Web.Components.Features.AuthInfo.Entities
@using Web.Components.Features.Categories.Models
@using Web.Components.Features.Categories.Queries
@inject IMediator Sender
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Articles</PageTitle>

<section class="app-page-stack">
	<div class="app-page-card">
		<div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
			<div>
				<p class="app-pill">Publishing</p>
				<h1 class="app-h1">All Articles</h1>
			</div>

			<div class="flex flex-wrap items-center gap-4">
				<label class="flex items-center gap-2 text-sm font-medium text-(--app-text)">
					<input type="checkbox"
								 class="h-4 w-4 rounded border-slate-400 text-sky-600 focus:ring-sky-500"
								 @bind="_showMyArticlesOnly"
								 @bind:after="HandleFilterChanged" />
					Show My Articles Only
				</label>

				<button type="button"
								class="inline-flex items-center justify-center rounded-lg bg-sky-600 px-4 py-2 font-medium text-white hover:bg-sky-500"
								@onclick="OpenCreatePanel">
					Create New Article
				</button>
			</div>
		</div>
	</div>

	@if (_showCreatePanel)
	{
		<section class="app-panel-card">
			<div class="app-section-header">
				<h2 class="app-section-title">Create article</h2>
				<button type="button"
								class="rounded border border-slate-400 px-2.5 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800"
								@onclick="CloseCreatePanel">
					Cancel
				</button>
			</div>

			@if (!string.IsNullOrWhiteSpace(_error))
			{
				<div class="alert-error" role="alert">@_error</div>
			}

			<ArticleForm Model="_form"
									 Categories="_categories"
									 Saving="_saving"
									 SubmitLabel="Create article"
									 OnValidSubmit="CreateArticleAsync" />
		</section>
	}

	<section class="app-panel-card">
		<div class="app-section-header">
			<h2 class="app-section-title">Articles</h2>
			<span class="app-badge">@FilteredArticles.Count total</span>
		</div>

		@if (!string.IsNullOrWhiteSpace(_loadError))
		{
			<div class="alert-error" role="alert">@_loadError</div>
		}

		@if (_loading)
		{
			<p class="app-copy">Loading articles...</p>
		}
		else if (FilteredArticles.Count == 0)
		{
			<p class="app-copy">No articles to show yet.</p>
		}
		else
		{
			<div class="overflow-x-auto">
				<table class="w-full text-left text-sm">
					<thead>
						<tr class="border-b border-slate-200 text-xs font-semibold tracking-wide text-slate-500 uppercase dark:border-slate-700 dark:text-slate-400">
							@foreach (var column in SortColumns)
							{
								<th class="cursor-pointer px-3 py-2 select-none" @onclick="() => SetSort(column)">
									@ColumnLabel(column)@SortIndicator(column)
								</th>
							}
							<th class="px-3 py-2">Actions</th>
						</tr>
					</thead>
					<tbody>
						@{ var rowIndex = 0; }
						@foreach (var article in PagedArticles)
						{
							var canEdit = ArticleAuthorizationService.CanEditArticle(_currentUser, article);
							var rowClass = rowIndex % 2 == 0
								? "bg-white dark:bg-slate-900"
								: "bg-slate-50 dark:bg-slate-950/40";
							rowIndex++;

							<tr class="border-b border-slate-100 @rowClass dark:border-slate-800">
								<td class="px-3 py-2 font-medium text-(--app-text)">@article.Title</td>
								<td class="px-3 py-2">@article.Author.Name</td>
								<td class="px-3 py-2">@article.Category.CategoryName</td>
								<td class="px-3 py-2">@(article.IsPublished ? "Published" : "Draft")</td>
								<td class="px-3 py-2">@(article.IsPublished && article.PublishedOn is { } publishedOn ? publishedOn.ToString("MMM d, yyyy") : "—")</td>
								<td class="px-3 py-2">
									<div class="flex flex-wrap items-center gap-2">
										<a href="@($"/articles/{article.Id}")"
											 class="rounded border border-slate-400 px-2.5 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800">
											View
										</a>

										@if (canEdit)
										{
											@if (article.IsPublished)
											{
												<button type="button"
																class="rounded border border-slate-400 px-2.5 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800"
																@onclick="() => UnpublishArticleAsync(article.Id)">
													Unpublish
												</button>
											}
											else
											{
												<button type="button"
																class="rounded border border-emerald-500 px-2.5 py-1.5 text-sm font-medium text-emerald-600 hover:bg-emerald-50 dark:hover:bg-emerald-950/30"
																@onclick="() => PublishArticleAsync(article.Id)">
													Publish
												</button>
											}

											<a href="@($"/articles/{article.Id}/edit")"
												 class="rounded border border-sky-500 px-2.5 py-1.5 text-sm font-medium text-sky-600 hover:bg-sky-50 dark:hover:bg-sky-950/30">
												Edit
											</a>

											@if (_pendingDeleteId == article.Id)
											{
												<span class="text-sm text-slate-600 dark:text-slate-300">Delete this article?</span>
												<button type="button"
																class="rounded border border-rose-500 bg-rose-50 px-2.5 py-1.5 text-sm font-medium text-rose-600 hover:bg-rose-100 dark:bg-rose-950/30 dark:hover:bg-rose-950/50"
																@onclick="() => DeleteArticleAsync(article.Id)">
													Confirm
												</button>
												<button type="button"
																class="rounded border border-slate-400 px-2.5 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800"
																@onclick="CancelDelete">
													Cancel
												</button>
											}
											else
											{
												<button type="button"
																class="rounded border border-rose-500 px-2.5 py-1.5 text-sm font-medium text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/30"
																@onclick="() => RequestDelete(article.Id)">
													Delete
												</button>
											}
										}
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>

			<div class="mt-4 flex items-center justify-between text-sm text-slate-600 dark:text-slate-300">
				<span>Page @_currentPage of @TotalPages</span>
				<div class="flex gap-2">
					<button type="button"
									class="rounded border border-slate-400 px-2.5 py-1.5 font-medium disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600"
									disabled="@(_currentPage <= 1)"
									@onclick="PreviousPage">
						Previous
					</button>
					<button type="button"
									class="rounded border border-slate-400 px-2.5 py-1.5 font-medium disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600"
									disabled="@(_currentPage >= TotalPages)"
									@onclick="NextPage">
						Next
					</button>
				</div>
			</div>
		}
	</section>
</section>

@code {
	private const int PageSize = 10;

	private enum SortColumn
	{
		Title,
		Author,
		Category,
		Status,
		Published
	}

	private static readonly SortColumn[] SortColumns =
	[
		SortColumn.Title, SortColumn.Author, SortColumn.Category, SortColumn.Status, SortColumn.Published
	];

	private readonly ArticleFormModel _form = new();
	private readonly List<ArticleDto> _articles = [];
	private readonly List<CategoryDto> _categories = [];
	private bool _loading;
	private bool _saving;
	private bool _showCreatePanel;
	private bool _showMyArticlesOnly;
	private string? _error;
	private string? _loadError;
	private string? _pendingDeleteId;
	private ClaimsPrincipal? _currentUser;
	private SortColumn _sortColumn = SortColumn.Title;
	private bool _sortAscending = true;
	private int _currentPage = 1;

	private List<ArticleDto> FilteredArticles =>
	[
		.. _articles.Where(article => !_showMyArticlesOnly || IsOwnedByCurrentUser(article))
	];

	private List<ArticleDto> SortedArticles
	{
		get
		{
			var filtered = FilteredArticles.AsEnumerable();

			var ordered = _sortColumn switch
			{
				SortColumn.Author => Order(filtered, article => article.Author.Name),
				SortColumn.Category => Order(filtered, article => article.Category.CategoryName),
				SortColumn.Status => Order(filtered, article => article.IsPublished),
				SortColumn.Published => Order(filtered, article => article.PublishedOn ?? DateTime.MinValue),
				_ => Order(filtered, article => article.Title)
			};

			return [.. ordered];
		}
	}

	private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredArticles.Count / (double)PageSize));

	private List<ArticleDto> PagedArticles =>
	[
		.. SortedArticles.Skip((_currentPage - 1) * PageSize).Take(PageSize)
	];

	protected override async Task OnInitializedAsync()
	{
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		_currentUser = authState.User;
		await LoadCategoriesAsync();
		await LoadAsync();
	}

	private IOrderedEnumerable<ArticleDto> Order<TKey>(IEnumerable<ArticleDto> source, Func<ArticleDto, TKey> keySelector)
	{
		return _sortAscending ? source.OrderBy(keySelector) : source.OrderByDescending(keySelector);
	}

	private bool IsOwnedByCurrentUser(ArticleDto article)
	{
		var currentUserId = ArticleAuthorizationService.GetCurrentUserId(_currentUser);
		return !string.IsNullOrWhiteSpace(currentUserId) && article.Author.UserId == currentUserId;
	}

	private static string ColumnLabel(SortColumn column) => column switch
	{
		SortColumn.Title => "Title",
		SortColumn.Author => "Author",
		SortColumn.Category => "Category",
		SortColumn.Status => "Status",
		SortColumn.Published => "Published",
		_ => string.Empty
	};

	private string SortIndicator(SortColumn column)
	{
		if (column != _sortColumn)
		{
			return string.Empty;
		}

		return _sortAscending ? " ▲" : " ▼";
	}

	private void SetSort(SortColumn column)
	{
		if (_sortColumn == column)
		{
			_sortAscending = !_sortAscending;
		}
		else
		{
			_sortColumn = column;
			_sortAscending = true;
		}

		_currentPage = 1;
	}

	private void HandleFilterChanged()
	{
		_currentPage = 1;
	}

	private void OpenCreatePanel()
	{
		_showCreatePanel = true;
	}

	private void CloseCreatePanel()
	{
		_showCreatePanel = false;
		_error = null;
		_form.Reset();
	}

	private void PreviousPage()
	{
		if (_currentPage > 1)
		{
			_currentPage--;
		}
	}

	private void NextPage()
	{
		if (_currentPage < TotalPages)
		{
			_currentPage++;
		}
	}

	private void RequestDelete(string id)
	{
		_pendingDeleteId = id;
	}

	private void CancelDelete()
	{
		_pendingDeleteId = null;
	}

	private async Task LoadCategoriesAsync()
	{
		var result = await Sender.Send(new GetCategoriesQuery());
		if (result.Success)
		{
			_categories.Clear();
			_categories.AddRange(result.Value ?? []);
		}
	}

	private async Task LoadAsync()
	{
		_loading = true;
		_loadError = null;

		var result = await Sender.Send(new GetArticlesQuery());
		if (result.Success)
		{
			var visibleArticles = (result.Value ?? [])
				.Where(article => ArticleAuthorizationService.CanViewArticle(_currentUser, article))
				.ToList();

			_articles.Clear();
			_articles.AddRange(visibleArticles);
		}
		else
		{
			_loadError = result.Error;
		}

		_loading = false;

		if (_currentPage > TotalPages)
		{
			_currentPage = TotalPages;
		}
	}

	private async Task CreateArticleAsync()
	{
		_saving = true;
		_error = null;

		var title = _form.Title.Trim();
		var category = _categories.FirstOrDefault(c => c.Id.ToString() == _form.CategoryId);
		var result = await Sender.Send(new CreateArticleCommand(
			title,
			title.GenerateSlug(),
			_form.Content.Trim(),
			AuthorDto.FromClaimsPrincipal(_currentUser),
			category));

		if (result.Success)
		{
			_form.Reset();
			_showCreatePanel = false;
			await LoadAsync();
		}
		else
		{
			_error = result.Error;
		}

		_saving = false;
	}

	private async Task DeleteArticleAsync(string id)
	{
		_error = null;
		_pendingDeleteId = null;
		var result = await Sender.Send(new DeleteArticleCommand(id));
		if (result.Success)
		{
			await LoadAsync();
		}
		else
		{
			_error = result.Error;
		}
	}

	private async Task PublishArticleAsync(string id)
	{
		_error = null;
		var result = await Sender.Send(new PublishArticleCommand(id));
		if (result.Success)
		{
			await LoadAsync();
		}
		else
		{
			_error = result.Error;
		}
	}

	private async Task UnpublishArticleAsync(string id)
	{
		_error = null;
		var result = await Sender.Send(new UnpublishArticleCommand(id));
		if (result.Success)
		{
			await LoadAsync();
		}
		else
		{
			_error = result.Error;
		}
	}
}
