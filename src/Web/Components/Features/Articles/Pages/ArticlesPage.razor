@page "/articles"
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.QuickGrid
@using static Domain.Helpers.DomainHelpers
@using Web.Components.Features.Articles.Authorization
@using Web.Components.Features.Articles.Commands
@using Web.Components.Features.Articles.Components
@using Web.Components.Features.Articles.Models
@using Web.Components.Features.Articles.Queries
@using Web.Components.Features.AuthInfo.Entities
@using Web.Components.Features.Categories.Models
@using Web.Components.Features.Categories.Queries
@inject IMediator Sender
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Articles</PageTitle>

<section class="app-page-stack">
	<div class="app-page-card">
		<div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
			<div>
				<h2 class="app-h2">All Articles</h2>
			</div>
			<div>
				<p class="app-pill">Publishing</p>
			</div>
			<div class="flex flex-wrap items-center gap-4">
				<label class="flex items-center gap-2 text-sm font-medium text-(--app-text)">
					<input type="checkbox" class="h-4 w-4 rounded border-slate-400 text-sky-600 focus:ring-sky-500"
								 @bind="_showMyArticlesOnly" />
					Show My Articles Only
				</label>

				<label class="flex items-center gap-2 text-sm font-medium text-(--app-text)">
					<input type="checkbox" class="h-4 w-4 rounded border-slate-400 text-sky-600 focus:ring-sky-500"
								 @bind="_includeArchived" />
					Include Archived
				</label>

				@if (_canCreateArticle)
				{
					<button type="button" class="app-button app-button-primary" @onclick="OpenCreatePanel">
						Create New Article
					</button>
				}
			</div>
		</div>
	</div>

	@if (_showCreatePanel)
	{
		<section class="app-panel-card">
			<div class="app-section-header">
				<h2 class="app-section-title">Create article</h2>
				<button type="button" class="app-button app-button-secondary" @onclick="CloseCreatePanel">
					Cancel
				</button>
			</div>

			@if (!string.IsNullOrWhiteSpace(_error))
			{
				<div class="alert-error" role="alert">@_error</div>
			}

			<ArticleForm Model="_form" Categories="_categories" Saving="_saving" SubmitLabel="Create article"
									 OnValidSubmit="CreateArticleAsync" />
		</section>
	}

	<section class="app-panel-card">
		<div class="app-section-header flex-wrap gap-3">
			<h2 class="app-section-title">Articles</h2>
			<div class="flex flex-1 flex-wrap items-center justify-end gap-3">
				<input type="search" aria-label="Search articles by title or author" placeholder="Search by title or author..."
							 class="w-full max-w-xs rounded-full border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
							 @bind="_searchText" @bind:event="oninput" />
				<span class="app-badge">@FilteredArticleList.Count total</span>
			</div>
		</div>

		@if (!string.IsNullOrWhiteSpace(_loadError))
		{
			<div class="alert-error" role="alert">@_loadError</div>
		}

		@if (_loading)
		{
			<p class="app-copy">Loading articles...</p>
		}
		else if (FilteredArticleList.Count == 0)
		{
			<p class="app-copy">No articles to show yet.</p>
		}
		else
		{
			<div class="overflow-x-auto">
				<QuickGrid TGridItem="ArticleDto" Items="@FilteredArticles" Pagination="@_pagination"
									 Class="zebra-grid w-full text-left text-sm">
					<TemplateColumn Title="Title" Sortable="true" IsDefaultSortColumn="true"
													SortBy="@(GridSort<ArticleDto>.ByAscending(a => a.Title))" Class="font-medium text-(--app-text)">
						<ChildContent Context="context">
							@context.Title
							@if (context.IsArchived)
							{
								<span class="app-badge ml-2" role="status">Archived</span>
							}
						</ChildContent>
						<ColumnOptions>
							<input type="text" aria-label="Filter by title" placeholder="Filter title"
										 class="app-button app-button-actions"
										 @bind="_titleFilter" @bind:event="oninput" />
						</ColumnOptions>
					</TemplateColumn>

					<PropertyColumn Property="@(a => a.Author.Name)" Title="Author" Sortable="true">
						<ColumnOptions>
							<input type="text" aria-label="Filter by author" placeholder="Filter author"
										 class="app-button app-button-actions"
										 @bind="_authorFilter" @bind:event="oninput" />
						</ColumnOptions>
					</PropertyColumn>

					<PropertyColumn Property="@(a => a.Category.CategoryName)" Title="Category" Sortable="true">
						<ColumnOptions>
							<select aria-label="Filter by category" class="app-button app-button-actions" @bind="_categoryFilter">
								<option value="">All categories</option>
								@foreach (var category in _categories)
								{
									<option value="@category.Id.ToString()">@category.CategoryName@(category.IsArchived ? " (archived)" : "")
									</option>
								}
							</select>
						</ColumnOptions>
					</PropertyColumn>

					<TemplateColumn Title="Status" Sortable="true" SortBy="@(GridSort<ArticleDto>.ByAscending(a => a.IsPublished))">
						<ChildContent Context="context">
							@(context.IsPublished ? "Published" : "Draft")
						</ChildContent>
						<ColumnOptions>
							<select aria-label="Filter by status" class="app-button app-button-actions" @bind="_statusFilter">
								<option value="All">All</option>
								<option value="Published">Published</option>
								<option value="Draft">Draft</option>
							</select>
						</ColumnOptions>
					</TemplateColumn>

					<TemplateColumn Title="Published" Sortable="true"
													SortBy="@(GridSort<ArticleDto>.ByAscending(a => a.PublishedOn))">
						@(context.IsPublished && context.PublishedOn is { } publishedOn ? publishedOn.ToString("MMM d, yyyy") : "—")
					</TemplateColumn>

					<TemplateColumn Sortable="false" Class="text-center">
						<HeaderTemplate>
							<div class="flex justify-center font-bold">Actions</div>
						</HeaderTemplate>
						<ChildContent Context="context">
							@{
								var canEdit = ArticleAuthorizationService.CanEditArticle(_currentUser, context);
								var canArchive = ArticleAuthorizationService.CanArchiveArticle(_currentUser, context);
								const string btnShape = "w-24 rounded-full border px-2 py-1 text-center text-xs font-medium";
								const string baseBtn = $"{btnShape} border-slate-400 text-slate-600 dark:border-slate-600 dark:text-slate-300";
								const string neutralHover = "hover:bg-slate-100 dark:hover:bg-slate-800";
								const string skyHover = "hover:border-sky-500 hover:text-sky-600 hover:bg-sky-50 dark:hover:bg-sky-950/30";
								const string emeraldHover = "hover:border-emerald-500 hover:text-emerald-600 hover:bg-emerald-50 dark:hover:bg-emerald-950/30";
								const string amberHover = "hover:border-amber-500 hover:text-amber-700 hover:bg-amber-50 dark:hover:bg-amber-950/30";
								const string disabledClass = $"{btnShape} cursor-not-allowed border-slate-300 text-slate-400 opacity-60 dark:border-slate-700 dark:text-slate-600";
							}
							<div class="flex flex-nowrap items-center justify-center gap-1.5 whitespace-nowrap">
								<a href="@($"/articles/{context.Slug}")" class="@baseBtn @neutralHover">
									View
								</a>

								@if (canEdit)
								{
									<a href="@($"/articles/{context.Slug}/edit")" class="@baseBtn @skyHover">
										Edit
									</a>
								}
								else
								{
									<span aria-disabled="true" title="You don't have permission to edit this article" class="@disabledClass">
										Edit
									</span>
								}

								@if (context.IsPublished)
								{
									<button type="button" disabled="@(!canEdit)"
													title="@(canEdit ? null : "You don't have permission to edit this article")"
													class="@(canEdit ? $"{baseBtn} {neutralHover}" : disabledClass)"
													@onclick="() => UnpublishArticleAsync(context.Id)">
										Unpublish
									</button>
								}
								else
								{
									<button type="button" disabled="@(!canEdit)"
													title="@(canEdit ? null : "You don't have permission to edit this article")"
													class="@(canEdit ? $"{baseBtn} {emeraldHover}" : disabledClass)"
													@onclick="() => PublishArticleAsync(context.Id)">
										Publish
									</button>
								}

								@if (context.IsArchived)
								{
									<button type="button" disabled="@(!canArchive)"
													title="@(canArchive ? null : "Only administrators can archive articles")"
													class="@(canArchive ? $"{baseBtn} {emeraldHover}" : disabledClass)"
													@onclick="() => UnarchiveArticleAsync(context.Id)">
										Unarchive
									</button>
								}
								else
								{
									<button type="button" disabled="@(!canArchive)"
													title="@(canArchive ? null : "Only administrators can archive articles")"
													class="@(canArchive ? $"{baseBtn} {amberHover}" : disabledClass)"
													@onclick="() => RequestArchive(context.Id)">
										Archive
									</button>
								}
							</div>
						</ChildContent>
					</TemplateColumn>
				</QuickGrid>
			</div>

			<div class="mt-4 flex justify-end text-sm text-slate-600 dark:text-slate-300">
				<Paginator State="@_pagination" />
			</div>
		}
	</section>
</section>

@if (_pendingArchiveId is not null)
{
	<div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/50 p-4" role="presentation"
			 @onclick="CancelArchive">
		<div class="app-panel-card w-full max-w-sm" role="dialog" aria-modal="true" aria-labelledby="archive-modal-title"
				 @onclick:stopPropagation="true">
			<h2 id="archive-modal-title" class="text-lg font-semibold text-(--app-text)">Archive article?</h2>
			<p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
				"@_pendingArchiveTitle" will be hidden from the default articles list. You can unarchive it later.
			</p>
			<div class="mt-6 flex justify-end gap-2">
				<button type="button" class="app-button app-button-secondary" @onclick="CancelArchive">
					Cancel
				</button>
				<button type="button" class="app-button app-button-warning"
								@onclick="() => ArchiveArticleAsync(_pendingArchiveId!)">
					Confirm
				</button>
			</div>
		</div>
	</div>
}

@code {
	private readonly ArticleFormModel _form = new();
	private readonly List<ArticleDto> _articles = [];
	private readonly List<CategoryDto> _categories = [];
	private readonly PaginationState _pagination = new() { ItemsPerPage = 10 };
	private bool _loading;
	private bool _saving;
	private bool _showCreatePanel;
	private bool _showMyArticlesOnly;
	private bool _includeArchived;
	private string _searchText = string.Empty;
	private string _titleFilter = string.Empty;
	private string _authorFilter = string.Empty;
	private string _categoryFilter = string.Empty;
	private string _statusFilter = "All";
	private string? _error;
	private string? _loadError;
	private string? _pendingArchiveId;
	private ClaimsPrincipal? _currentUser;
	private bool _canCreateArticle;

	private List<ArticleDto> FilteredArticleList =>
	[
		.. _articles
			.Where(article => !_showMyArticlesOnly || IsOwnedByCurrentUser(article))
			.Where(article => _includeArchived || !article.IsArchived)
			.Where(MatchesGlobalSearch)
			.Where(MatchesTitleFilter)
			.Where(MatchesAuthorFilter)
			.Where(MatchesCategoryFilter)
			.Where(MatchesStatusFilter)
	];

	private IQueryable<ArticleDto> FilteredArticles => FilteredArticleList.AsQueryable();

	private string? _pendingArchiveTitle => _articles.FirstOrDefault(a => a.Id == _pendingArchiveId)?.Title;

	protected override async Task OnInitializedAsync()
	{
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		_currentUser = authState.User;
		_canCreateArticle = ArticleAuthorizationService.CanCreateArticle(_currentUser);
		await LoadCategoriesAsync();
		await LoadAsync();
	}

	private bool IsOwnedByCurrentUser(ArticleDto article)
	{
		var currentUserId = ArticleAuthorizationService.GetCurrentUserId(_currentUser);
		return !string.IsNullOrWhiteSpace(currentUserId) && article.Author.UserId == currentUserId;
	}

	private bool MatchesGlobalSearch(ArticleDto article)
	{
		return string.IsNullOrWhiteSpace(_searchText)
					 || article.Title.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
					 || article.Author.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase);
	}

	private bool MatchesTitleFilter(ArticleDto article)
	{
		return string.IsNullOrWhiteSpace(_titleFilter)
					 || article.Title.Contains(_titleFilter, StringComparison.OrdinalIgnoreCase);
	}

	private bool MatchesAuthorFilter(ArticleDto article)
	{
		return string.IsNullOrWhiteSpace(_authorFilter)
					 || article.Author.Name.Contains(_authorFilter, StringComparison.OrdinalIgnoreCase);
	}

	private bool MatchesCategoryFilter(ArticleDto article)
	{
		return string.IsNullOrWhiteSpace(_categoryFilter)
					 || article.Category.Id.ToString() == _categoryFilter;
	}

	private bool MatchesStatusFilter(ArticleDto article)
	{
		return _statusFilter switch
		{
			"Published" => article.IsPublished,
			"Draft" => !article.IsPublished,
			_ => true
		};
	}

	private void OpenCreatePanel()
	{
		_showCreatePanel = true;
	}

	private void CloseCreatePanel()
	{
		_showCreatePanel = false;
		_error = null;
		_form.Reset();
	}

	private void RequestArchive(string id)
	{
		_pendingArchiveId = id;
	}

	private void CancelArchive()
	{
		_pendingArchiveId = null;
	}

	private async Task LoadCategoriesAsync()
	{
		var result = await Sender.Send(new GetCategoriesQuery());
		if (result.Success)
		{
			_categories.Clear();
			_categories.AddRange(result.Value ?? []);
		}
	}

	private async Task LoadAsync()
	{
		_loading = true;
		_loadError = null;

		var result = await Sender.Send(new GetArticlesQuery());
		if (result.Success)
		{
			var visibleArticles = (result.Value ?? [])
				.Where(article => ArticleAuthorizationService.CanViewArticle(_currentUser, article))
				.ToList();

			_articles.Clear();
			_articles.AddRange(visibleArticles);
		}
		else
		{
			_loadError = result.Error;
		}

		_loading = false;
	}

	private async Task CreateArticleAsync()
	{
		_saving = true;
		_error = null;

		var title = _form.Title.Trim();
		var category = _categories.FirstOrDefault(c => c.Id.ToString() == _form.CategoryId);
		var result = await Sender.Send(new CreateArticleCommand(
			title,
			title.GenerateSlug(),
			_form.Content.Trim(),
			AuthorDto.FromClaimsPrincipal(_currentUser),
			category));

		if (result.Success)
		{
			_form.Reset();
			_showCreatePanel = false;
			await LoadAsync();
		}
		else
		{
			_error = result.Error;
		}

		_saving = false;
	}

	private async Task PublishArticleAsync(string id)
	{
		_error = null;
		var result = await Sender.Send(new PublishArticleCommand(id));
		if (result.Success)
		{
			await LoadAsync();
		}
		else
		{
			_error = result.Error;
		}
	}

	private async Task UnpublishArticleAsync(string id)
	{
		_error = null;
		var result = await Sender.Send(new UnpublishArticleCommand(id));
		if (result.Success)
		{
			await LoadAsync();
		}
		else
		{
			_error = result.Error;
		}
	}

	private async Task ArchiveArticleAsync(string id)
	{
		_error = null;
		_pendingArchiveId = null;
		var result = await Sender.Send(new ArchiveArticleCommand(id));
		if (result.Success)
		{
			await LoadAsync();
		}
		else
		{
			_error = result.Error;
		}
	}

	private async Task UnarchiveArticleAsync(string id)
	{
		_error = null;
		var result = await Sender.Send(new UnarchiveArticleCommand(id));
		if (result.Success)
		{
			await LoadAsync();
		}
		else
		{
			_error = result.Error;
		}
	}
}
