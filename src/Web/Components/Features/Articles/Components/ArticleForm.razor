@using Web.Components.Features.Articles.Models
@using Web.Components.Features.Categories.Models

<EditForm Model="Model" OnValidSubmit="HandleValidSubmit">
	<DataAnnotationsValidator />
	<ValidationSummary />

	<div class="space-y-4">
		<div>
			<label class="block text-sm font-medium text-(--app-text)">Title</label>
			<InputText id="article-title" @bind-Value="Model.Title"
								 class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100" />
		</div>

		<div>
			<label class="block text-sm font-medium text-(--app-text)">Content</label>
			<TextEditor @bind-Content="Model.Content" AlignmentOptionsEnabled="true"
									UploadingChanged="@(uploading => _uploadingImage = uploading)" />
			@if (_uploadingImage)
			{
				<p class="mt-1 text-sm text-(--app-text-muted)">Uploading image...</p>
			}
		</div>

		<div>
			<label class="block text-sm font-medium text-(--app-text)">Category</label>
			<InputSelect id="article-category" @bind-Value="Model.CategoryId"
									 class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100">
				<option value="">Select a category</option>
				@foreach (var category in Categories)
				{
					<option value="@category.Id.ToString()">@category.CategoryName</option>
				}
			</InputSelect>
		</div>

		<div class="flex items-center gap-2">
			<button type="submit"
							class="app-button app-button-primary"
							disabled="@(Saving || _uploadingImage)">
				@(Saving ? "Saving..." : SubmitLabel)
			</button>
			@FooterActions
		</div>
	</div>
</EditForm>

@code {
	[Parameter, EditorRequired]
	public ArticleFormModel Model { get; set; } = default!;

	[Parameter, EditorRequired]
	public IReadOnlyList<CategoryDto> Categories { get; set; } = [];

	[Parameter]
	public bool Saving { get; set; }

	[Parameter]
	public string SubmitLabel { get; set; } = "Save";

	[Parameter]
	public EventCallback OnValidSubmit { get; set; }

	[Parameter]
	public RenderFragment? FooterActions { get; set; }

	private bool _uploadingImage;

	private Task HandleValidSubmit() => OnValidSubmit.InvokeAsync();
}
