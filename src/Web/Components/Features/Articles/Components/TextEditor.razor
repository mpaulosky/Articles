@using PSC.Blazor.Components.MarkdownEditor
@using PSC.Blazor.Components.MarkdownEditor.Enums
@using PSC.Blazor.Components.MarkdownEditor.EventsArgs
@using PSC.Blazor.Components.MarkdownEditor.Models
@using Web.Components.Features.Articles.Services
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject IFileStorage FileStorage
@inject ILogger<TextEditor> Logger


<MarkdownEditor @bind-Value="@MyContent" CustomImageUpload="@HandleImageUpload" UploadImage="true"
								ImageUploadStarted="@OnImageUploadStarted" ImageUploadEnded="@OnImageUploadEnded"
								CustomButtonClicked="@OnCustomButtonClicked" @ref="@_textEditor"
								MinHeight="@MinHeight">
	<Toolbar>
		<MarkdownToolbarButton Action="MarkdownAction.Bold" Name="Bold" Icon="fa fa-bold" Title="Bold" />
		<MarkdownToolbarButton Action="MarkdownAction.Italic" Name="Italic" Icon="fa fa-italic" Title="Italic" />
		<MarkdownToolbarButton Action="MarkdownAction.Strikethrough" Name="Strike Through" Icon="fa fa-strikethrough"
													 Title="Strike Through" />
		<MarkdownToolbarButton Action="MarkdownAction.HorizontalRule" Name="Horizontal Rule" Icon="fa fa-window-minimize"
													 Title="Horizontal Rule" />
		<MarkdownToolbarButton Separator Action="MarkdownAction.Heading" Name="Header" Icon="fa fa-header"
													 Title="Heading" />
		<MarkdownToolbarButton Action="MarkdownAction.Quote" Name="Add Quote" Icon="fa fa-quote-left" Title="Quote" />
		<MarkdownToolbarButton Action="MarkdownAction.UnorderedList" Name="Add Un-ordered-List" Icon="fa fa-list-ul"
													 Title="Unordered List" />
		<MarkdownToolbarButton Action="MarkdownAction.OrderedList" Name="Add Ordered-List" Icon="fa fa-list-ol"
													 Title="ordered List" />

		@if (AlignmentOptionsEnabled)
		{
			<MarkdownToolbarButton Separator Name="Align Left" Value="@("left")" Icon="fa fa-align-left" Title="Align Left" />
			<MarkdownToolbarButton Name="Align Centre" Value="@("center")" Icon="fa fa-align-center" Title="Align Centre" />
			<MarkdownToolbarButton Name="Align Right" Value="@("right")" Icon="fa fa-align-right" Title="Align Right" />
		}

		<MarkdownToolbarButton Separator Action="MarkdownAction.Link" Name="Add Link" Icon="fa fa-link" Title="Link" />
		<MarkdownToolbarButton Action="MarkdownAction.Image" Name="Add Image" Icon="fa fa-image" Title="Image" />
		<MarkdownToolbarButton Action="MarkdownAction.Table" Name="Add Table" Icon="fa fa-table" Title="Add Table" />
		<MarkdownToolbarButton Separator Action="MarkdownAction.Preview" Name="preview" Icon="no-disable fa fa-eye"
													 Title="Toggle Preview" />
		<MarkdownToolbarButton Action="MarkdownAction.Code" Name="Code Block" Icon="fa fa-code" Title="Code Block" />
		<MarkdownToolbarButton Separator Action="MarkdownAction.Fullscreen" Name="Fullscreen" Icon="fa fa-arrows-alt"
													 Title="Fullscreen" />
		<MarkdownToolbarButton Separator Action="MarkdownAction.Guide" Name="Markdown Guide" Icon="fa fa-question-circle"
													 Title="Markdown Guide" />
	</Toolbar>
</MarkdownEditor>

@code {

	MarkdownEditor _textEditor = null!;

	[Parameter, EditorRequired]
	public bool AlignmentOptionsEnabled { get; set; }

	[Parameter]
	public string MinHeight { get; set; } = "500px";

	private string _content = string.Empty;

	// An image upload round-trips through JS (save the file, then insert markdown pointing at
	// it back on the client) and only the *insertion* raises MyContent's setter. If the form is
	// submitted after the upload finishes but before that insertion lands, the saved article ends
	// up missing the image even though the file itself was written to disk. Block submission for
	// that window rather than just the upload's own network round-trip.
	private bool _awaitingContentSyncAfterUpload;

	// Files uploaded via this editor instance that haven't been confirmed as saved yet. Only ever
	// populated from HandleImageUpload - never from pre-existing content - so it's safe to delete
	// anything that drops off this set the moment it's no longer referenced: nothing already-persisted
	// could depend on a file that was never part of a saved article.
	private readonly HashSet<string> _unconfirmedUploads = new(StringComparer.OrdinalIgnoreCase);

	// The file name of the upload currently awaited by _awaitingContentSyncAfterUpload. MyContent can
	// change for unrelated reasons (typing) while an insertion is still in flight, so the awaiting flag
	// is only cleared once this specific file's reference actually lands in content - not on the next
	// MyContent change regardless of cause.
	private string? _pendingUploadFileName;

	public string MyContent
	{
		get => _content;
		set
		{
			_content = value;
			if (_awaitingContentSyncAfterUpload && _pendingUploadFileName is not null
				&& ArticleImageParser.ExtractFileNames(value).Contains(_pendingUploadFileName))
			{
				_awaitingContentSyncAfterUpload = false;
				_pendingUploadFileName = null;
				UploadingChanged.InvokeAsync(false);
			}
			ContentChanged.InvokeAsync(value);
			_ = DeleteUploadsNoLongerReferencedAsync(value);
		}
	}

	[Parameter, EditorRequired]
	public string Content { get => _content; set => _content = value; }

	[Parameter]
	public EventCallback<string> ContentChanged { get; set; }

	[Parameter]
	public EventCallback<bool> UploadingChanged { get; set; }

	public async Task<FileEntry> HandleImageUpload(MarkdownEditor editor, FileEntry file)
	{
		// Convert the base64 string to a byte array and load it into a memory stream
		var bytes = Convert.FromBase64String(file.ContentBase64);
		string fileName;
		await using (var stream = new MemoryStream(bytes))
		{
			// Assign fileName from a storage operation
			fileName = await FileStorage.AddFile(new FileData(stream, new FileMetaData(file.Name, "", file.LastModified)));
		}

		_unconfirmedUploads.Add(fileName);
		_pendingUploadFileName = fileName;
		file.UploadUrl = new Uri(new Uri(NavigationManager.BaseUri), $"/uploads/{fileName}").ToString();
		return file;
	}

	/// <summary>
	///     Deletes any uploads from this session that <paramref name="content" /> no longer
	///     references - the user inserted an image, then removed or replaced it before saving.
	/// </summary>
	private async Task DeleteUploadsNoLongerReferencedAsync(string content)
	{
		if (_unconfirmedUploads.Count == 0)
		{
			return;
		}

		var stillReferenced = ArticleImageParser.ExtractFileNames(content);
		var noLongerReferenced = _unconfirmedUploads.Where(fileName => !stillReferenced.Contains(fileName)).ToList();
		foreach (var fileName in noLongerReferenced)
		{
			_unconfirmedUploads.Remove(fileName);
			try
			{
				await FileStorage.DeleteFile(fileName);
			}
			catch (Exception ex)
			{
				Logger.LogWarning(ex, "Failed to delete unused upload {FileName}", fileName);
			}
		}
	}

	private Task OnImageUploadStarted(FileStartedEventArgs args)
	{
		_awaitingContentSyncAfterUpload = true;
		return UploadingChanged.InvokeAsync(true);
	}

	private Task OnImageUploadEnded(FileEndedEventArgs args)
	{
		if (args.Success)
		{
			// Wait for the markdown insertion to reach MyContent instead of clearing here.
			return Task.CompletedTask;
		}

		_awaitingContentSyncAfterUpload = false;
		_pendingUploadFileName = null;
		return UploadingChanged.InvokeAsync(false);
	}

	public async Task OnCustomButtonClicked(MarkdownButtonEventArgs args)
	{
		// Get the selected text using JavaScript
		var selectedText = await JsRuntime.InvokeAsync<string>("getSelectedText", ".EasyMDEContainer textarea");

		if (!string.IsNullOrEmpty(selectedText))
		{
			// Wrap the selected text with the chosen alignment
			var wrappedText = $"<div style='text-align:{args.Value}'>{selectedText}</div>";

			// Replace the selected text in the editor
			MyContent = MyContent.Replace(selectedText, wrappedText);

			// Update the editor
			await _textEditor.SetValueAsync(MyContent);
		}
	}
}
