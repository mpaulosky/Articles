@using Web.Services
@inject HttpClient Http

<footer class="app-footer">
	<div class="app-footer-inner">
		<div class="app-footer-brand">
			<span>© @CurrentYear Articles</span>
			<span>@(CompanyName)</span>
		</div>

		<div class="app-footer-meta">
			<span class="app-footer-label">GitHub Release</span>
			<span class="app-footer-value">@ReleaseTag</span>
		</div>

		<div class="app-footer-meta">
			<span class="app-footer-label">Last Commit</span>
			<span class="app-footer-value">@LastCommit</span>
		</div>
	</div>
</footer>

@code {
	private int CurrentYear => DateTime.UtcNow.Year;
	private string CompanyName => "from mpaulosky.org";

	private string _releaseTag = "no release";
	private string _lastCommit = "unknown";

	private string ReleaseTag => _releaseTag;
	private string LastCommit => _lastCommit;

	protected override async Task OnInitializedAsync()
	{
		var metadata = await GitHubMetadataProvider.GetMetadataAsync(Http);
		_releaseTag = metadata?.ReleaseTag ?? "no release";
		_lastCommit = metadata?.LastCommit ?? "unknown";
	}
}
