@inject IJSRuntime JS

<header class="app-header">
	<div class="flex items-center justify-between gap-3 px-4 py-3 md:px-6">
		<a href="/" class="app-brand">
			<span class="app-brand-mark">A</span>
			Articles
		</a>

		<div class="flex items-center gap-3">
			<nav class="app-nav hidden items-center gap-2 md:flex">
				<a href="/" class="theme-nav-link">Overview</a>
				<a href="/counter" class="theme-nav-link">Counter</a>
			</nav>
			<button
				type="button"
				class="theme-toggle"
				aria-label="@(isDarkMode ? "Switch to light theme" : "Switch to dark theme")"
				title="@(isDarkMode ? "Switch to light theme" : "Switch to dark theme")"
				@onclick="ToggleTheme">
				@(isDarkMode ? "☀️" : "🌙")
			</button>
		</div>
	</div>
</header>

@code {
	private bool isDarkMode;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			var theme = await JS.InvokeAsync<string>("getTheme");
			isDarkMode = string.Equals(theme, "dark", StringComparison.OrdinalIgnoreCase);
			StateHasChanged();
		}
	}

	private async Task ToggleTheme()
	{
		isDarkMode = !isDarkMode;
		await JS.InvokeVoidAsync("applyTheme", isDarkMode ? "dark" : "light");
		StateHasChanged();
	}
}
