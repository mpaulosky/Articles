<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UserSecretsId>94491f6e-auth0-values-3ff40da38702</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="../Domain/Domain.csproj" />
		<ProjectReference Include="..\ServiceDefaults\ServiceDefaults.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" />
		<PackageReference Include="Aspire.StackExchange.Redis.OutputCaching" />
		<PackageReference Include="Aspire.MongoDB.Driver" />
		<PackageReference Include="Auth0.AspNetCore.Authentication" />
		<PackageReference Include="Auth0.ManagementApi" />
		<PackageReference Include="Bogus" />
		<PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
		<PackageReference Include="HtmlSanitizer" />
		<PackageReference Include="Markdig" />
		<PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" />
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
		<PackageReference Include="MongoDB.Driver" />
		<PackageReference Include="MongoDB.EntityFrameworkCore" />
		<PackageReference Include="PSC.Blazor.Components.MarkdownEditor" />
		<PackageReference Include="SkiaSharp" />
		<PackageReference Include="SkiaSharp.NativeAssets.Linux" />
		<PackageReference Include="Snappier" />
		<PackageReference Include="WaffleGenerator.Bogus" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="AppHost.Tests" />
		<InternalsVisibleTo Include="Architecture.Tests" />
		<InternalsVisibleTo Include="Domain.Tests" />
		<InternalsVisibleTo Include="Web.Tests" />
		<InternalsVisibleTo Include="Web.UI.Tests" />
		<InternalsVisibleTo Include="Web.E2E.Tests" />
		<InternalsVisibleTo Include="Web.Integration.Tests" />
		<InternalsVisibleTo Include="Web.TestData" />
	</ItemGroup>

	<!--
		Generate BuildInfo.g.cs at build time with the git tag and short commit hash.
		FooterComponent reads BuildInfo.Version and BuildInfo.Commit at runtime.
	-->
	<ItemGroup>
		<Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" Condition="Exists('$(IntermediateOutputPath)BuildInfo.g.cs')" />
	</ItemGroup>
	<PropertyGroup>
		<PnpmCommand Condition="'$(PnpmCommand)' == ''">pnpm</PnpmCommand>
	</PropertyGroup>

	<Target Name="GetGitBuildInfo" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
		<Exec Command="git fetch --tags --prune origin" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="Low" StandardErrorImportance="Low" />
		<Exec Command="git tag --sort=-creatordate | head -n 1" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="Low" StandardErrorImportance="Low">
			<Output TaskParameter="ConsoleOutput" PropertyName="_RawGitTag" />
		</Exec>
		<Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="Low" StandardErrorImportance="Low">
			<Output TaskParameter="ConsoleOutput" PropertyName="_RawGitCommit" />
		</Exec>

		<PropertyGroup>
			<_GitTag>$(_RawGitTag.Trim())</_GitTag>
			<_GitCommit>$(_RawGitCommit.Trim())</_GitCommit>
			<_GitTag Condition="'$(_GitTag)' == '' OR $([System.String]::Copy('$(_GitTag)').Contains('fatal:'))">no release</_GitTag>
			<_GitCommit Condition="'$(_GitCommit)' == ''">unknown</_GitCommit>
		</PropertyGroup>

		<ItemGroup>
			<_BuildInfoLine Include="// &lt;auto-generated /&gt;" />
			<_BuildInfoLine Include="// Copyright (c) 2026. All rights reserved." />
			<_BuildInfoLine Include="namespace UI%3B" />
			<_BuildInfoLine Include="/// &lt;summary&gt;Build-time git metadata baked in by GetGitBuildInfo MSBuild target.&lt;/summary&gt;" />
			<_BuildInfoLine Include="internal static class BuildInfo" />
			<_BuildInfoLine Include="{" />
			<_BuildInfoLine Include="    internal const string Version = &quot;$(_GitTag)&quot;%3B" />
			<_BuildInfoLine Include="    internal const string Commit = &quot;$(_GitCommit)&quot;%3B" />
			<_BuildInfoLine Include="}" />
		</ItemGroup>

		<WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.g.cs" Lines="@(_BuildInfoLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
		<ItemGroup>
			<Compile Remove="$(IntermediateOutputPath)BuildInfo.g.cs" />
			<Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
		</ItemGroup>
	</Target>

	<!--
	Ensure that pnpm is available on the build machine.
	If not, check if a pre-built app.css exists. If neither is true, fail the build.
-->
	<Target Name="DetectPnpm" BeforeTargets="EnsurePnpmPackages;BuildTailwind" Condition="'$(CI)' != 'true' AND '$(CI)' != '1'">
		<Exec Command="$(PnpmCommand) --version" IgnoreExitCode="true">
			<Output TaskParameter="ExitCode" PropertyName="PnpmExitCode" />
		</Exec>
		<PropertyGroup>
			<PnpmAvailable Condition="'$(PnpmExitCode)' == '0'">true</PnpmAvailable>
			<PnpmAvailable Condition="'$(PnpmExitCode)' != '0'">false</PnpmAvailable>
		</PropertyGroup>
		<Error Condition="'$(PnpmAvailable)' != 'true' AND !Exists('$(MSBuildProjectDirectory)/wwwroot/css/app.css')" Text="pnpm was not found and no pre-built app.css exists. Install Node.js and pnpm (corepack enable) and run 'cd src/Web &amp;&amp; pnpm install --frozen-lockfile' before building." />
		<Warning Condition="'$(PnpmAvailable)' != 'true' AND Exists('$(MSBuildProjectDirectory)/wwwroot/css/app.css')" Text="pnpm was not found. Skipping Tailwind build and using the existing generated CSS at wwwroot/css/app.css." />
	</Target>

	<!-- On a fresh machine, node_modules won't exist. Auto-run pnpm install before Tailwind builds. -->
	<Target Name="EnsurePnpmPackages" BeforeTargets="BuildTailwind" Condition="'$(CI)' != 'true' AND '$(CI)' != '1' AND '$(PnpmAvailable)' == 'true' AND !Exists('$(MSBuildProjectDirectory)/node_modules')">
		<Message Importance="high" Text="node_modules not found — running pnpm install..." />
		<Exec Command="$(PnpmCommand) install --frozen-lockfile --ignore-scripts" WorkingDirectory="$(MSBuildProjectDirectory)" />
	</Target>

	<!--
		Only reinstall when pnpm-lock.yaml actually changed since the last install (tracked via
		the stamp file). Reinstalling unconditionally on every build deletes and rebuilds node_modules
		out from under any concurrently running `pnpm run watch:css`, causing intermittent
		"Can't resolve 'tailwindcss'" failures in the watcher.
	-->
	<Target Name="TailwindPnpmInstall" BeforeTargets="TailwindBuild" Condition="Exists('package.json')" Inputs="$(MSBuildProjectDirectory)/pnpm-lock.yaml" Outputs="$(MSBuildProjectDirectory)/node_modules/.install-stamp">
		<Exec Command="$(PnpmCommand) install --frozen-lockfile" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Touch Files="$(MSBuildProjectDirectory)/node_modules/.install-stamp" AlwaysCreate="true" />
	</Target>

	<!-- wwwroot/app.css is generated here and not committed, so a Tailwind
	     bump can never leave a stale copy behind. It runs before BeforeBuild
	     so the file exists before static web assets are collected. -->
	<Target Name="TailwindBuild" BeforeTargets="BeforeBuild">
		<Exec Command="$(PnpmCommand) run build:css" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="Exists('package.json')" />
		<!-- wwwroot/** was globbed when the project loaded, before this file
		     existed, so add it now or a clean build leaves it out of the static
		     web assets manifest and @Assets["app.css"] can't serve it. -->
		<ItemGroup>
			<Content Include="wwwroot/app.css" Exclude="@(Content)" />
		</ItemGroup>
	</Target>

</Project>
